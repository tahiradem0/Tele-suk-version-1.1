# ==========================================
# Gondar ሱቅ Backend Environment Variables
# Copy to .env locally OR add in Render Dashboard
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URLs (CORS & Payment Return Redirects)
FRONTEND_URL=https://your-app.vercel.app
# Optional: Comma-separated custom domains (all *.vercel.app domains are allowed automatically)
ALLOWED_ORIGINS=https://your-custom-domain.com

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/tele-suk?retryWrites=true&w=majority

# Authentication (Generate a 64-char hex secret)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Payment Gateway (Chapa)
CHAPA_SECRET_KEY=CHASECK-your_live_secret_key
CHAPA_LIVE_SECRET_KEY=CHASECK-your_live_secret_key
CHAPA_LIVE_PUBLIC_KEY=CHAPUBK-your_live_public_key
CHAPA_TEST_SECRET_KEY=CHASECK_TEST-your_test_secret_key
CHAPA_TEST_PUBLIC_KEY=CHAPUBK_TEST-your_test_public_key

# Cloud Storage (Cloudinary - Required on Render for persistent product/banner images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
